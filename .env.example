# Copy to .env and fill in. Loaded automatically by scripts/doctor.py and
# scripts/play.py. Both forms work, with or without the `export` prefix:
#
#   export TYPESAFE_API_KEY="..."   <- also works with `source .env`
#   TYPESAFE_API_KEY=...
#
# Real environment variables take precedence over this file.

# Get a key from https://console.typesafe.ai/settings/keys
export TYPESAFE_API_KEY="your-key-here"
